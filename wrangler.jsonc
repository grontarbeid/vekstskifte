// Oppsett for Cloudflare Workers. Nettsiden ligger i public/, serverfunksjonen i src/worker.js.
// API-nøkkelen legges inn som hemmelighet hos Cloudflare (ANTHROPIC_API_KEY), aldri her.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vekstskifte",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Hvilken Claude-modell KI-delen bruker
    "MODELL": "claude-sonnet-5-5"
  },
  // Takt: høyst 20 KI-forespørsler i minuttet fra samme adresse og 200 i minuttet til sammen
  "ratelimits": [
    { "name": "TAKT", "namespace_id": "4101", "simple": { "limit": 20, "period": 60 } },
    { "name": "TAKT_ALLE", "namespace_id": "4102", "simple": { "limit": 200, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
